{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repo Context Contradiction",
  "type": "object",
  "required": [
    "key",
    "reasons",
    "claims"
  ],
  "properties": {
    "schema": {
      "type": "string"
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ]
          },
          "worker": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {},
          "unit": {},
          "polarity": {},
          "reducer": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
