{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo-context-recall-result/v1",
  "title": "Repository Context Recall Result",
  "type": "object",
  "required": ["schema", "classification", "query", "model_payload", "sidecar", "metrics", "context_status"],
  "properties": {
    "schema": {"const": "repo-context-recall-result/v1"},
    "classification": {"const": "deterministic-repository-context-recall"},
    "query": {"type": "string", "minLength": 1},
    "model_payload": {
      "type": "object",
      "required": ["evidence", "policy"],
      "properties": {
        "evidence": {"type": "array", "items": {"type": "object"}},
        "policy": {"type": "object"}
      },
      "additionalProperties": true
    },
    "sidecar": {"type": "object"},
    "metrics": {
      "type": "object",
      "required": ["candidate_count", "recalled_count", "model_visible_tokens", "model_calls_added"],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "recalled_count": {"type": "integer", "minimum": 0},
        "model_visible_tokens": {"type": "integer", "minimum": 0},
        "model_calls_added": {"const": 0}
      },
      "additionalProperties": true
    },
    "context_status": {
      "type": "object",
      "required": ["sufficient", "escalation_recommended", "reason"],
      "properties": {
        "sufficient": {"type": "boolean"},
        "escalation_recommended": {"type": "boolean"},
        "reason": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
