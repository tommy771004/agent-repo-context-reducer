{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repo Context Finding",
  "type": "object",
  "required": [
    "claim",
    "evidence",
    "source"
  ],
  "properties": {
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "canonicalKey": {
      "type": "string",
      "minLength": 1
    },
    "canonical_key": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string"
    },
    "predicate": {
      "type": "string"
    },
    "period": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "value": {},
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "polarity": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "type": [
        "object",
        "null"
      ]
    },
    "trust": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
