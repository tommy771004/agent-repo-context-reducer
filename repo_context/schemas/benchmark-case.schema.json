{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reducer End-to-End Benchmark Case",
  "type": "object",
  "required": [
    "task",
    "worker_outputs"
  ],
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1
    },
    "worker_outputs": {
      "type": "array"
    },
    "required_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_contradiction_count": {
      "type": "integer",
      "minimum": 0
    },
    "synthesis_budget": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}
