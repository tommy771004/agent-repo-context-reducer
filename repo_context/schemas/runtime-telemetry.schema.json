{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo-context-runtime-telemetry/v1",
  "title": "Repo Context Runtime Telemetry",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "workers",
    "status_counts",
    "input_tokens",
    "output_tokens",
    "total_tokens",
    "cost_completeness"
  ],
  "properties": {
    "schema": {
      "const": "repo-context-runtime-telemetry/v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workers": {
      "type": "integer",
      "minimum": 0
    },
    "status_counts": {
      "type": "object"
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "total_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "latency_ms_sum": {
      "type": "number",
      "minimum": 0
    },
    "reported_cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "reported_cost_samples": {
      "type": "integer",
      "minimum": 0
    },
    "cost_completeness": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unreported"
      ]
    },
    "path": {
      "type": "string"
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
